diff --git a/ui/src/ui/chat/context-notice.ts b/ui/src/ui/chat/context-notice.ts
index 80d30b764f..6e0c406d9c 100644
--- a/ui/src/ui/chat/context-notice.ts
+++ b/ui/src/ui/chat/context-notice.ts
@@ -73,10 +73,14 @@ export function getContextNoticeViewModel(
   const ratio = used / limit;
   const pct = Math.min(Math.round(ratio * 100), 100);
   const warning = ratio >= CONTEXT_NOTICE_RATIO;
+  const savings = formatCostSavings(session?.inputTokens, session?.outputTokens);
+  const detail = savings
+    ? `${formatTokensCompact(used)} / ${formatTokensCompact(limit)} · ${savings}`
+    : `${formatTokensCompact(used)} / ${formatTokensCompact(limit)}`;
   if (!warning) {
     return {
       pct,
-      detail: `${formatTokensCompact(used)} / ${formatTokensCompact(limit)}`,
+      detail,
       color: "var(--muted)",
       bg: "color-mix(in srgb, var(--muted) 8%, transparent)",
       warning,
@@ -96,7 +100,7 @@ export function getContextNoticeViewModel(
   const bg = `rgba(${r}, ${g}, ${b}, ${bgOpacity})`;
   return {
     pct,
-    detail: `${formatTokensCompact(used)} / ${formatTokensCompact(limit)}`,
+    detail,
     color,
     bg,
     warning,
@@ -185,3 +189,29 @@ function formatTokensCompact(n: number): string {
   }
   return String(n);
 }
+
+const CLOUD_PRICING: Record<string, { input: number; output: number }> = {
+  "claude-sonnet-4-5": { input: 3.0,  output: 15.0 },
+  "claude-opus-4":     { input: 15.0, output: 75.0 },
+  "claude-haiku-4-5":  { input: 0.8,  output: 4.0  },
+  "gpt-4o":            { input: 2.5,  output: 10.0 },
+  "gpt-4o-mini":       { input: 0.15, output: 0.6  },
+  "gemini-1.5-pro":    { input: 1.25, output: 5.0  },
+};
+const DEFAULT_PRICING = { input: 3.0, output: 15.0 };
+
+/** Compute what this session would have cost on a cloud model, formatted as a string. */
+function formatCostSavings(
+  inputTokens: number | undefined,
+  outputTokens: number | undefined,
+): string | null {
+  if (!inputTokens && !outputTokens) return null;
+  const pricing = DEFAULT_PRICING;
+  const savings =
+    ((inputTokens ?? 0) / 1e6) * pricing.input +
+    ((outputTokens ?? 0) / 1e6) * pricing.output;
+  if (savings < 0.0001) return null;
+  return savings < 0.01
+    ? `saved ~$${(savings * 1000).toFixed(2)}m`
+    : `saved ~$${savings.toFixed(4)}`;
+}
diff --git a/ui/src/ui/views/usage-render-overview.ts b/ui/src/ui/views/usage-render-overview.ts
index 47504a18c6..a5c7b5dc5f 100644
--- a/ui/src/ui/views/usage-render-overview.ts
+++ b/ui/src/ui/views/usage-render-overview.ts
@@ -17,6 +17,19 @@ import {
   CostDailyEntry,
 } from "./usageTypes.ts";
 
+// Cloud reference pricing per 1M tokens (Claude Sonnet 4.5)
+const CLOUD_REF_INPUT_PER_M = 3.0;
+const CLOUD_REF_OUTPUT_PER_M = 15.0;
+
+function formatCloudSavings(inputTokens: number, outputTokens: number): string | null {
+  if (!inputTokens && !outputTokens) return null;
+  const savings =
+    (inputTokens / 1e6) * CLOUD_REF_INPUT_PER_M +
+    (outputTokens / 1e6) * CLOUD_REF_OUTPUT_PER_M;
+  if (savings < 0.0001) return null;
+  return savings < 1 ? `$${savings.toFixed(4)}` : `$${savings.toFixed(2)}`;
+}
+
 function pct(part: number, total: number): number {
   if (total === 0) {
     return 0;
@@ -569,6 +582,33 @@ function renderUsageInsights(
       <div class="card-title">${t("usage.overview.title")}</div>
       <div class="usage-overview-layout">
         <div class="usage-summary-grid">
+          ${(() => {
+            const savings = formatCloudSavings(totals.input, totals.output);
+            return savings
+              ? renderSummaryStat({
+                  title: "On-device Savings",
+                  hint: "What this would have cost on Claude Sonnet 4.5 ($3 input / $15 output per 1M tokens). Running on-device costs $0.",
+                  value: savings,
+                  sub: `vs ${formatTokens(totals.input + totals.output)} tokens on cloud`,
+                  tone: "good",
+                  className: "usage-summary-card--hero",
+                })
+              : nothing;
+          })()}
+          ${renderSummaryStat({
+            title: "Input tokens",
+            hint: "Total input (prompt) tokens sent to the model across all sessions.",
+            value: formatTokens(totals.input),
+            sub: `${formatTokens(totals.cacheRead)} cache read · ${formatTokens(totals.cacheWrite)} cache write`,
+            className: "usage-summary-card--half",
+          })}
+          ${renderSummaryStat({
+            title: "Output tokens",
+            hint: "Total output (completion) tokens generated by the model across all sessions.",
+            value: formatTokens(totals.output),
+            sub: `of ${formatTokens(totals.totalTokens)} total tokens`,
+            className: "usage-summary-card--half",
+          })}
           ${renderSummaryStat({
             title: t("usage.overview.messages"),
             hint: t("usage.overview.messagesHint"),
