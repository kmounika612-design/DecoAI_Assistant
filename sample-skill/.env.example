# OpenClaw Twitter Demo - Environment Variables
# Copy this file to .env and fill in all values before running setup.ps1

# ---------------------------------------------------------------------------
# X/Twitter app credentials (wosaiplugins2)
# Used by xurl to authenticate API calls to the X/Twitter platform.
# Obtain from the X Developer Portal: https://developer.x.com/en/portal/dashboard
# ---------------------------------------------------------------------------
XURL_CLIENT_ID=
XURL_CLIENT_SECRET=

# OAuth 1.0a credentials — used for user-context endpoints (tweets, DMs)
XURL_ACCESS_TOKEN=
XURL_TOKEN_SECRET=
XURL_CONSUMER_KEY=
XURL_CONSUMER_SECRET=

# Bearer token — used for app-only (read-only) endpoints
XURL_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Gemini API key (required for nano-banana-pro image generation)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Telegram bot token — enables the Telegram channel in openclaw
# Create a bot via @BotFather on Telegram to get this token
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Ollama API key — authenticates requests to the Ollama cloud endpoint
# Obtain from your Ollama account dashboard
# ---------------------------------------------------------------------------
OLLAMA_API_KEY=

# Brave Search API key — used by the openclaw brave plugin for web search
# Obtain from the Brave Search API dashboard: https://api.search.brave.com
BRAVE_API_KEY=

# openclaw gateway auth token — secures the local gateway HTTP endpoint
# Any random hex string works; generate one with: openssl rand -hex 24
OPENCLAW_GATEWAY_TOKEN=

# ---------------------------------------------------------------------------
# OpenRouter API key — enables OpenRouter models (including free models)
# Obtain from https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=